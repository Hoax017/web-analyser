{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Analyser",
  "version": "0.1.0",
  "identifier": "dev.webanalyser.app",
  "build": {
    "beforeDevCommand": "npm run build:agent && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:agent && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Web Analyser",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../capture-agent/dist/": "capture-agent/",
      "../capture-agent/package.json": "capture-agent/package.json",
      "../node_modules/playwright-core/": "capture-agent/node_modules/playwright-core/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
